# Copy to .env and adjust. `npm run db:setup` reads this file.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/costing_erp

# Signs the session cookie. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# The single login row db/setup.ts creates.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# Vamaa Dairy mobile-app API - only needed for the /procurement/vamaa viewer.
VAMAA_API_BASE_URL=https://proamcu.mobiledairy.co.in
VAMAA_API_KEY=
VAMAA_ORG_ID=
VAMAA_USERNAME=
VAMAA_PASSWORD=
VAMAA_CENTER_SHORT_NAME=
VAMAA_CENTER_UNIQUE_CODE=
