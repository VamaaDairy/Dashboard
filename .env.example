# Copy to .env and adjust. `npm run db:setup` reads this file.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/costing_erp

# Signs the session cookie. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# The single login row db/setup.ts creates.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# Vamaa Dairy mobile-app API - only needed for the /procurement/vamaa viewer.
VAMAA_API_BASE_URL=https://proamcu.mobiledairy.co.in
VAMAA_API_KEY=
VAMAA_ORG_ID=
VAMAA_USERNAME=
VAMAA_PASSWORD=
VAMAA_CENTER_SHORT_NAME=
VAMAA_CENTER_UNIQUE_CODE=

# ---------------------------------------------------------------- WhatsApp shop
# Meta app > WhatsApp > API Setup. Use a System User token (never expires) with
# whatsapp_business_messaging, whatsapp_business_management, catalog_management.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# Optional - found from WA_BUSINESS_ACCOUNT_ID when blank
WA_CATALOG_ID=
# Any secret string; type the same into Meta > WhatsApp > Configuration > Webhook
WA_VERIFY_TOKEN=
# App settings > Basic > App secret - rejects forged webhook calls
WA_APP_SECRET=
WA_GRAPH_VERSION=v25.0

# Public https URL of this app (the cloudflared tunnel while testing).
# Meta downloads product photos from <PUBLIC_BASE_URL>/products/<sku>.jpg
PUBLIC_BASE_URL=
SHOP_WEBSITE=

# Groq (console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# What the assistant tells customers
SHOP_NAME=Vamaa Dairy
SHOP_INFO=
SHOP_DELIVERY_FEE=0
SHOP_FREE_DELIVERY_ABOVE=0
SHOP_COD_ENABLED=true
# Payments: plain UPI (customer sends a screenshot, you mark paid) ...
SHOP_UPI_ID=
SHOP_UPI_NAME=
# ... or Razorpay payment links (test keys work), marked paid automatically
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
